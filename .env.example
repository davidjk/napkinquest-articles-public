# Public site URL (no trailing slash). Used for canonical, OG, hreflang, sitemap.
# In production this is the Cloudflare Pages custom domain (see README "Deploy").
# Local dev: leave as-is. Only canonical/OG URL strings reference it; nothing dereferences it.
SITE_URL=https://napkinquest.example.com

# Sub-path the site is served from. Leave blank for root-domain hosting.
BASE_PATH=

# --- Author / social handles ---
PUBLIC_GITHUB_HANDLE=davidjk
PUBLIC_GITHUB_REPO=napkinquest-articles-public
PUBLIC_TWITTER_HANDLE=
PUBLIC_CONTACT_EMAIL=

# --- Buttondown ---
# Your Buttondown username (the slug at https://buttondown.com/<username>).
# Drives the embedded subscribe form on the site.
PUBLIC_BUTTONDOWN_USERNAME=

# --- Giscus ---
# Master switch. Set "true" to enable.
PUBLIC_GISCUS_ENABLED=false
# Generate the values below at https://giscus.app
PUBLIC_GISCUS_REPO=your-handle/your-repo
PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxx
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxx
